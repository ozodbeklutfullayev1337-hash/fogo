datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum OrderStatus {
  pending
  delivered
  cancelled
}

model User {
  id         Int      @id @default(autoincrement())
  telegramId BigInt   @unique
  firstName  String?
  phone      String?
  createdAt  DateTime @default(now())
  orders     Order[]
}

model Product {
  id          Int      @id @default(autoincrement())
  name        String
  description String?
  imageUrl    String
  oldPrice    Float?
  newPrice    Float
  category    String
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
}

model Order {
  id         Int         @id @default(autoincrement())
  userId     Int
  user       User        @relation(fields: [userId], references: [id])
  items      Json
  totalPrice Float
  location   String?
  status     OrderStatus @default(pending)
  createdAt  DateTime    @default(now())
}
